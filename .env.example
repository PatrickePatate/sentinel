APP_NAME=Sentinel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
# Set to true in production (HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
OPENROUTER_API_KEY=
# Agent model (provider names come from config/ai.php)
SENTINEL_AI_PROVIDER=openai
SENTINEL_AI_MODEL=gpt-6.1-sol
OPENAI_API_KEY=
OPENAI_STORE=false

# Risk gate classifier (Jev via OpenRouter)
SENTINEL_GATE_PROVIDER=openrouter
SENTINEL_GATE_MODEL=

# Public IP(s) Sentinel connects from, IPv4 and IPv6 (comma separated, CIDR ok). Restricts the deployed SSH key and
# whitelists Sentinel in fail2ban. Set BOTH families if unsure; empty = key accepted from anywhere.
SENTINEL_SOURCE_IPS=

SENTINEL_TRANSPORT=fake
SENTINEL_FAKE_LATENCY_MS=400
SENTINEL_RESTARTABLE_SERVICES=nginx,php8.3-fpm,mysql,redis-server
SENTINEL_USE_SUDO=true
# Ed25519 key that signs client bundles (machines refuse unsigned ones). Created on first use; back it up: losing it
# means re-running the provisioning one-liner on every machine. Default: storage/app/private/bundle-signing.key
# SENTINEL_BUNDLE_SIGNING_KEY_PATH=
SENTINEL_RELOADABLE_SERVICES=
SENTINEL_UPGRADABLE_PACKAGES=

# Optional cheaper model for autonomous (scheduled) scans; both must be set, otherwise the default above is used.
SENTINEL_SCHEDULED_PROVIDER=
SENTINEL_SCHEDULED_MODEL=

# Autonomous scans and notifications need both a queue worker and the scheduler:
#   php artisan queue:work        (and in production: cron `* * * * * php artisan schedule:run`)
# Telegram buttons need a public HTTPS APP_URL, then "Register Telegram webhook" on the channel in the back-office
# (or `php artisan sentinel:telegram-webhook <channel-id>`). Mail uses the usual MAIL_* settings.

# Realtime dashboard over WebSockets (Laravel Reverb). Without it the dashboard polls. Run: php artisan reverb:start
SENTINEL_REALTIME=false
REVERB_APP_ID=sentinel
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Hosts allowed to open a WebSocket (comma separated, no scheme). Defaults to * (any): set it in production.
# REVERB_APP_ALLOWED_ORIGINS=sentinel.example.org
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
